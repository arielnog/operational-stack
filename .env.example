# =============================================================
#  .env — Copie para .env e preencha com seus valores reais
#  NUNCA comite o .env no git!
# =============================================================

# --- Domínio principal ---
DOMAIN=arnsolutions.tech

# --- Let's Encrypt (e-mail para alertas de expiração) ---
LETSENCRYPT_EMAIL=arielnnogueira@hotmail.com

# --- Cloudflare ---
CF_DNS_API_TOKEN="seu_token_cloudflare_aqui"

# --- Metabase (banco próprio) ---
METABASE_DB=metabase
METABASE_DB_USER=metabase_user
METABASE_DB_PASSWORD="senha_aqui"

# --- Grafana (usa SQLite interno) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD="senha_aqui"

# --- RabbitMQ (compartilhado — ver rabbitmq/README.md) ---
# Administrador; cada app tem usuário e vhost próprios
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD="senha_aqui"

# --- Redis (compartilhado — ver redis/databases.md) ---
REDIS_PASSWORD="senha_aqui"

# --- Dashboard Traefik (basic auth) ---
# Gere o hash com: echo "usuario:$(openssl passwd -apr1 senha)" | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH="usuario:hash_aqui"

# --- Monitoramento (Alloy) ---
# Usuário monitor (role pg_monitor) criado em cada banco. Gere com: openssl rand -hex 24
POSTGRES_MONITOR_PASSWORD="senha_aqui"

# --- Alertas (Grafana → WhatsApp via Evolution) ---
EVOLUTION_ALERT_INSTANCE="nome_da_instancia"
EVOLUTION_ALERT_APIKEY="token_da_instancia"
ALERT_WHATSAPP_NUMBER="55DDD9XXXXXXXX"
