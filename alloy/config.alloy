// Convertido de promtail/promtail.yml com `alloy convert` (report.txt).
// Mantém os mesmos labels: container/service/project (Docker) e job/host/filename (arquivos).

logging {
	level = "warn"
}

discovery.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "docker" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_image"]
		target_label  = "image"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "project"
	}

	rule {
		source_labels = ["container"]
		regex         = ".+"
		action        = "keep"
	}
}

loki.source.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.docker.targets
	forward_to       = [loki.write.default.receiver]
	relabel_rules    = discovery.relabel.docker.rules
	refresh_interval = "5s"
}

loki.source.file "syslog" {
	targets = [{
		__address__ = "localhost",
		__path__    = "/var/log/syslog",
		host        = "vps",
		job         = "syslog",
	}]
	forward_to = [loki.write.default.receiver]

	file_match {
		enabled = true
	}
}

loki.source.file "auth" {
	targets = [{
		__address__ = "localhost",
		__path__    = "/var/log/auth.log",
		host        = "vps",
		job         = "auth",
	}]
	forward_to = [loki.write.default.receiver]

	file_match {
		enabled = true
	}
}

loki.process "traefik" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			client_host = "ClientHost",
			duration    = "Duration",
			method      = "RequestMethod",
			path        = "RequestPath",
			status      = "ResponseCode",
		}
	}

	stage.labels {
		values = {
			method = null,
			status = null,
		}
	}
}

loki.source.file "traefik" {
	targets = [{
		__address__ = "localhost",
		__path__    = "/var/log/traefik/*.log",
		host        = "vps",
		job         = "traefik",
	}]
	forward_to = [loki.process.traefik.receiver]

	file_match {
		enabled = true
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}
