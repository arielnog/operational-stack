    {
      "type": "timeseries",
      "id": 19,
      "title": "Erros por app",
      "description": "Linhas com error/exception/fatal/panic/critical.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
