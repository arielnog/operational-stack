      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "refId": "A",
          "legendFormat": "{{container}}",
          "expr": "sum by (container) (count_over_time({container=~\"$app\"} |~ \"(?i)(error|exception|fatal|panic|critical)\" [$__interval]))"
        }
      ],
